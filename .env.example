# Copy to .env and edit before the first `docker compose up`.

# Postgres password (used by db, app, backup). Required. Letters and digits
# only, because it goes into a connection URL. One way to make one:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# First-boot admin (applied only when no users exist yet; min 8 chars)
ADMIN_EMAIL=
ADMIN_NAME=Admin
ADMIN_PASSWORD=

# The exact address people will type in the browser. Sign-in forms are checked
# against it, and localhost, 127.0.0.1 and a LAN address all count as different,
# so use the one you'll actually visit.
# Examples:
#   http://localhost:3000           (only on the host itself)
#   http://192.168.1.20:3000        (from other machines on your LAN)
ORIGIN=http://localhost:3000
# Host port for the app (change if 3000 is already taken)
# JOURNAL_PORT=3000

# Image to run. The default is the latest release; pin a version to upgrade on your terms.
# JOURNAL_IMAGE=ghcr.io/zypher-systems/journal:0.2.2

# Only set to true when serving over HTTPS (e.g. behind Caddy)
COOKIE_SECURE=false

# Behind a reverse proxy, read the visitor's address from its header so sign-in
# throttling sees real clients. Leave unset without a proxy: clients could fake it.
# ADDRESS_HEADER=X-Forwarded-For
